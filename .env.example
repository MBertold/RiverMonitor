# Database Configuration
POSTGRES_DB=rivermonitor
POSTGRES_USER=riveruser
POSTGRES_PASSWORD=riverpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Connection URLs
# Async (used by FastAPI async endpoints)
DATABASE_URL=postgresql+asyncpg://riveruser:riverpassword@db:5432/rivermonitor
# Sync (used for migrations / synchronous ETL scripts)
DATABASE_URL_SYNC=postgresql+psycopg2://riveruser:riverpassword@db:5432/rivermonitor

# Application Settings
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]
